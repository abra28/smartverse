# SmartVerse Backend Environment Variables
# Copy this to .env and fill in your values

NODE_ENV=development
PORT=3000

# Add your production domains here (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-domain.com

# API Keys (add more for different controllers/churches)
API_KEYS=smartverse-demo-key-2026,your-church-key-2026

# Optional: Redis URL for production session persistence
# REDIS_URL=redis://localhost:6379

# Optional: Bible API key (ESV, API.Bible, etc.)
# BIBLE_API_KEY=your_bible_api_key_here
